# =====================================================================
# RapidRoute Emergency Vehicle Route Planning & ML Platform
# Environment Configuration - Example Template (Never commit real keys)
# =====================================================================

# Server Runtime
NODE_ENV="development"
PORT=3000
HOST="0.0.0.0"

# Application URL (Auto-injected in cloud environments)
APP_URL="http://localhost:3000"

# PostgreSQL with PostGIS Spatial Database
# Format: postgresql://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL="postgresql://rapidroute:tactical_secure_pass@localhost:5432/rapidroute_db"
DB_MAX_POOL=20
DB_IDLE_TIMEOUT_MS=30000
DB_CONN_TIMEOUT_MS=5000
USE_IN_MEMORY_DB="true"

# Redis Cache & Job Bus
# Format: redis://<host>:<port>
REDIS_URL="redis://localhost:6379"
CACHE_TTL_SECONDS=60
ROUTE_CACHE_TTL_SECONDS=30
USE_IN_MEMORY_REDIS="true"

# Security & Authentication
# Secret used for signing HMAC bearer tokens for dispatchers and emergency units
JWT_SECRET="rapidroute_tactical_jwt_secret_dev_key_never_in_production"
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW_MS=60000
CORS_ORIGINS="*"

# Routing Engine & ML Hyperparameters
ROUTING_VERSION="4.2.0"
ML_MODEL_VERSION="v4.2.1-gbdt"
ML_FEATURE_VERSION="f_v3"
STALE_FEED_THRESHOLD_SECONDS=180
SIGNIFICANT_ETA_DELTA_SECONDS=45

# Optional Gemini API key if multimodal assistant grounding is requested
GEMINI_API_KEY="YOUR_GEMINI_API_KEY_PLACEHOLDER"
